# ─────────────────────────────────────────────────────────────
# Leather Wallah — monorepo .gitignore
# Tracks all 3 apps (Admin / Backend / Frontend) + docs/.claude.
# Each app deploys separately in Coolify via its own base directory.
# ─────────────────────────────────────────────────────────────

# Node + builds
node_modules/
dist/
build/
.next/
*.log
npm-debug.log*

# Local-only settings
.claude/settings.local.json
.vscode/

# Env files (never commit secrets)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo

# Business / sensitive — EXCLUDED by default; opt-in if owner wants tracked
BuisnessPLan/

# Temp scratch outside of work folder
*.tmp
.cache/

# Playwright MCP run artifacts
.playwright-mcp/
.playwright-cli/

# Claude session scratch — Playwright test runs, results, screenshots
# (only this subfolder; the rest of .claude/work/ stays tracked)
.claude/work/playwright-tests/

# Debug/QA screenshots (local only)
*.jpeg
# Browser screenshots dropped at the repo root by Playwright runs.
# Leading slash = root only, so real image assets deeper in the tree stay tracked.
/*.png
LeatherWallahFrontend/public/img-check.html
