# ── Leather Wallah Backend — environment template ──
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# Server
PORT=5000
SITE_TITLE=Leather Wallah
SITE_URL=https://leatherwallah.com

# Database
MONGO_URI=

# JWT signing secret (used for the leather_wallah_token cookie)
ACCESS_TOKEN=

# S3 / object storage (Contabo / DigitalOcean Spaces — S3-compatible)
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=leather-wallah
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# Steadfast courier
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Pathao courier
PATHAO_WEBHOOK_SECRET=
PATHAO_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_CLIENT_EMAIL=
PATHAO_CLIENT_PASSWORD=
PATHAO_STORE_ID=

# Fraud detection
FRAUDBD_API_KEY=

# Meta (Facebook) Pixel + Conversion API
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# TikTok Pixel + Events API
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# BulkSMS BD (OTP + order SMS)
BULKSMS_API_KEY=
BULKSMS_SENDER_ID=

# SSLCommerz payment gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Public URLs (used in CAPI event_source_url, QR/barcode links, emails)
BACKEND_PUBLIC_URL=https://api.leatherwallah.com
FRONTEND_PUBLIC_URL=https://leatherwallah.com
