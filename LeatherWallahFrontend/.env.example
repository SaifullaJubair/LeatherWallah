# ── Leather Wallah Frontend — environment template ──
# Copy to `.env.local` and fill in real values.

# Backend API root (NO trailing /api/v1 — baseURL.js appends it)
NEXT_PUBLIC_API_URL=https://api.leatherwallah.com
API_URL=https://api.leatherwallah.com

# Full site URL for SEO / canonical / sitemap
NEXT_PUBLIC_SITE_URL=https://leatherwallah.com

# Server-side analytics IDs (NOT NEXT_PUBLIC_* — read server-side, passed via props)
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GTM_ID=
GA4_ID=
CLARITY_ID=

# Google Search Console verification (optional)
GOOGLE_VERIFICATION=
