# ── Leather Wallah Admin — environment template ──
# Copy to `.env` (or `.env.local`) and fill in real values.
# Vite inlines these at BUILD time, so rebuild after changing them.

# Backend API root (NO trailing /api/v1 — baseURL.js appends it)
VITE_API_URL=https://api.leatherwallah.com

# Storefront URL (used in the theme-preview "open storefront" link)
VITE_FRONTEND_URL=https://leatherwallah.com
